# Optional overrides. The defaults work from a fresh clone.
# The server reads these from the environment; it does not load this file.
#
# Scope is an exact normalized host:port allowlist. Point this at a different
# TOML file only if you are authorized to test the hosts in it.
XSS_HUNTER_SCOPE_CONFIG=config/scope.toml

# Append-only JSONL decisions and run events.
XSS_HUNTER_LOG_PATH=logs/scope.jsonl

# Per-target/run/finding evidence tree.
XSS_HUNTER_EVIDENCE_DIR=evidence

# Used only by the bundled lab app: uv run python -m labapp
XSS_HUNTER_LAB_PORT=5117
